{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/events.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/digest.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/funnel.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/sources.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/health.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/retention.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/grokbot-dispatch.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/grokbot-wechat-health.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/feedback.mjs",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/digest/?",
      "dest": "api/digest.mjs"
    },
    {
      "src": "/api/retention/?",
      "dest": "api/retention.mjs"
    },
    {
      "src": "/api/funnel/?",
      "dest": "api/funnel.mjs"
    },
    {
      "src": "/api/sources/?",
      "dest": "api/sources.mjs"
    },
    {
      "src": "/api/health/?",
      "dest": "api/health.mjs"
    },
    {
      "src": "/api/grokbot-dispatch/?",
      "dest": "api/grokbot-dispatch.mjs"
    },
    {
      "src": "/api/grokbot-wechat-health/?",
      "dest": "api/grokbot-wechat-health.mjs"
    },
    {
      "src": "/api/feedback/?",
      "dest": "api/feedback.mjs"
    },
    {
      "src": "/(.*)",
      "dest": "api/events.mjs"
    }
  ],
  "crons": [
    {
      "path": "/api/digest",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/retention",
      "schedule": "0 2 * * *"
    }
  ]
}
